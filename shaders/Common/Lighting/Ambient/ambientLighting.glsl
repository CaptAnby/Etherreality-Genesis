// ============================================================
// ETHERREALITY GENESIS :: AMBIENT LIGHTING
//
// Dynamic world fill light.
//
// Uses the WorldLighting state generated by:
//   /Common/Lighting/Environment/timeLighting.glsl
//
// Etherreality Genesis™ LIGHTING REVAMP
//
// Responsibilities:
//   - dynamic ambient color
//   - dynamic ambient intensity
//   - soft pale-blue world fill
//   - preserve direct-light contrast
//
// Cloud lighting can later reuse this same ambient state.
// ============================================================


// ============================================================
// AMBIENT CONTRIBUTION
// ============================================================

vec3 calculateGrandAmbientLight(
    vec3 albedo,
    WorldLighting worldLighting
) {

    // --------------------------------------------------------
    // Dynamic ambient state
    // --------------------------------------------------------

    vec3 ambient =
        worldLighting.ambientColor *
        worldLighting.ambientStrength;


    // --------------------------------------------------------
    // Etherreality Genesis™ ambient tone
    // --------------------------------------------------------
    //
    // Increase the visibility of the cool pale-blue character
    // without making the entire world visibly blue.
    // --------------------------------------------------------

    vec3 grandBlueTint =
        vec3(
            0.97,
            1.00,
            1.06
        );


    ambient *=
        grandBlueTint;


    // --------------------------------------------------------
    // Etherreality Genesis™ soft fill
    // --------------------------------------------------------
    //
    // Slightly stronger ambient presence so shaded surfaces
    // retain detail while direct sunlight remains dominant.
    // --------------------------------------------------------

    float ambientBoost =
        1.28;


    ambient *=
        ambientBoost;


    // --------------------------------------------------------
    // Apply to surface
    // --------------------------------------------------------

    return
        albedo *
        ambient;
}