// v = unit vector in the celestial frame (x=cos(dec)cos(ra), y=cos(dec)sin(ra), z=sin(dec)).
// Returns glow intensity 0..~1.2 (lines + star points).
float gmConstellations(vec3 v) {
    float acc = 0.0;
    for (int i = 0; i < CN_COUNT; i++) {
        vec4 a4 = CN_A[i];
        if (dot(v, CN_M[i]) < a4.w) continue;
        vec3 a = a4.xyz;
        vec3 b = CN_B[i];
        vec3 n = CN_N[i];
        float d = dot(v, n);
        float ia = dot(cross(a, v), n);
        float ib = dot(cross(v, b), n);
        if (ia > -0.002 && ib > -0.002) {
            acc += exp(-d * d * 413000.0) * 0.55 + exp(-d * d * 24700.0) * 0.16;
        }
        float da = 1.0 - dot(v, a);
        float db = 1.0 - dot(v, b);
        acc += (exp(-da * 81600.0) + exp(-db * 81600.0)) * 0.55
             + (exp(-da * 6900.0) + exp(-db * 6900.0)) * 0.10;
    }
    return min(acc, 1.6);
}
